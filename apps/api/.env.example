NODE_ENV=development
PORT=3000
ORACLE_USER=SLOW_DATING_DEV
# Local bootstrap passwords must be 12-128 characters using only A-Z, a-z, 0-9, underscore, or hyphen.
ORACLE_PASSWORD=replace-with-your-local-oracle-password
ORACLE_CONNECT_STRING=localhost:1521/XEPDB1
ORACLE_TEST_USER=SLOW_DATING_TEST
# Use the same conservative local-password policy for the TEST bootstrap password.
ORACLE_TEST_PASSWORD=replace-with-your-local-test-oracle-password
ORACLE_TEST_CONNECT_STRING=localhost:1521/XEPDB1
JWT_ACCESS_SECRET=replace-with-your-local-jwt-access-secret
OTP_PEPPER=replace-with-your-local-otp-pepper-value
REFRESH_TOKEN_PEPPER=replace-with-your-local-refresh-token-pepper
